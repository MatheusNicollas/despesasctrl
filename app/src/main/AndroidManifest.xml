<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.example.despesasctrl">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Economias">

        <activity
            android:name="com.example.despesasctrl.activity.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Economias">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name="com.example.despesasctrl.activity.ResumoActivity"
            android:exported="false" />
        <activity
            android:name="com.example.despesasctrl.activity.DetalhesCategoriaActivity"
            android:exported="false" />

    </application>

</manifest>